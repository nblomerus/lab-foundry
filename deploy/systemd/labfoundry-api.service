[Unit]
Description=LabFoundry command-center API (FastAPI on :8503)
After=network.target
# Keep retrying forever — when Postgres comes back, so do we.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/nicholas/workspace/lab-foundry
EnvironmentFile=/home/nicholas/workspace/lab-foundry/.env
ExecStart=/home/nicholas/.pyenv/versions/labfoundry/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8503
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
