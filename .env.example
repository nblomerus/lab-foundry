# Boardroom configuration. Copy to .env and fill in.

# --- Postgres (matches docker-compose defaults) ---
POSTGRES_USER=boardroom
POSTGRES_PASSWORD=boardroom
POSTGRES_DB=boardroom
DATABASE_URL=postgresql://boardroom:boardroom@localhost:5432/boardroom

# --- Ollama ---
OLLAMA_URL=http://localhost:11434

# --- Zep (cloud or self-hosted) ---
# Get a key at https://app.getzep.com if using cloud.
ZEP_API_KEY=
# Uncomment if self-hosting Zep via docker-compose:
# ZEP_BASE_URL=http://localhost:8000

# --- Langfuse (auto-created on first boot via docker-compose) ---
LANGFUSE_NEXTAUTH_SECRET=please-generate-random-32-bytes
LANGFUSE_SALT=please-generate-random-32-bytes
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Research tools ---
SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET=please-generate-random-32-bytes

# --- Optional: cloud model routing (v5) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
