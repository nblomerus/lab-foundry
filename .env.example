# LabFoundry configuration. Copy to .env and fill in.

# --- Postgres (matches docker-compose defaults) ---
POSTGRES_USER=labfoundry
POSTGRES_PASSWORD=boardroom
POSTGRES_DB=labfoundry
DATABASE_URL=postgresql://labfoundry:boardroom@localhost:5432/labfoundry

# --- Ollama ---
OLLAMA_URL=http://localhost:11434

# --- Zep (cloud or self-hosted) ---
# Get a key at https://app.getzep.com if using cloud.
ZEP_API_KEY=
# Uncomment if self-hosting Zep via docker-compose:
# ZEP_BASE_URL=http://localhost:8000

# --- Langfuse Cloud (free tier; self-host needs ClickHouse+Redis, too heavy for dev) ---
# Get keys at https://cloud.langfuse.com → Project Settings → API Keys.
# Leave empty to skip tracing — the router gracefully no-ops.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Research tools ---
SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET=please-generate-random-32-bytes

# --- Optional: cloud model routing (v5) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
