  "scripts": {
    "predev": "node -e \"var m=+process.versions.node.split('.')[0];if(m<20){console.error('\\n  Boardroom web requires Node >=20 (you are on '+process.version+').\\n  Run: nvm use   (see .nvmrc)\\n');process.exit(1);}\"",
    "dev": "next dev -p 8088",
